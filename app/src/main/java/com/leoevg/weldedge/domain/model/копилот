package com.leoevg.weldedge.domain

import kotlinx.serialization.Serializable

// Выбор пользователя на экране
@Serializable
data class WeldingSelection(
    val joint: JointType,
    val method: WeldingMethod,
    val materialThicknessMm: Double,
    val materialGrade: String?,
    val position: WeldingPosition = WeldingPosition.FLAT,
    val additional: Map<String, String> = emptyMap() // extensibility: e.g. preheat, backing, etc.
)

// Результат расчёта параметров
@Serializable
data class WeldingParameters(
    val currentA: Int?,
    val voltageV: Double?,
    val wireGrade: String?,
    val gas: String?,
    val fillerDiameterMm: Double?,
    val travelSpeedMmPerMin: Double?,
    val notes: List<String> = emptyList()
)

// Финальный отчёт
@Serializable
data class WeldingReport(
    val selection: WeldingSelection,
    val parameters: WeldingParameters,
    val standard: StandardReference?,
    val warnings: List<String> = emptyList()
)

@Serializable
data class StandardReference(
    val id: String,
    val title: String,
    val url: String? = null
)

sealed class JointType {
    object Butt : JointType()
    object Lap : JointType()
    data class Fillet(val legAmm: Double? = null, val legBmm: Double? = null) : JointType()
    object T : JointType()
    // extendable
}

enum class WeldingMethod {
    SMAW, GMAW, GTAW, FCAW, SAW
}

enum class WeldingPosition { FLAT, HORIZONTAL, VERTICAL, OVERHEAD }


package com.leoevg.weldedge.domain

interface StandardsRepository {
    suspend fun getStandardsFor(selection: WeldingSelection): List<StandardReference>
    suspend fun getRulesFor(method: WeldingMethod, jointType: JointType): List<CalculationRule>
}

interface ParametersRepository {
    suspend fun saveReport(report: WeldingReport)
    suspend fun loadSavedReports(): List<WeldingReport>
}

// Простая модель правила, парсится из JSON (data layer)
data class CalculationRule(
    val id: String,
    val description: String,
    val conditions: List<Condition>, // data-driven conditions
    val outputs: List<OutputSpec>
)

data class Condition(val key: String, val operator: String, val value: String)
data class OutputSpec(val key: String, val expression: String) // expression -> how to compute output (could be simple math or lookup)


package com.leoevg.weldedge.domain.calculators

import com.leoevg.weldedge.domain.*
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

// Strategy interface
interface ParameterCalculator {
    suspend fun calculate(selection: WeldingSelection, standards: List<StandardReference>): Result<WeldingParameters>
}

// Factory to choose strategy based on welding method
interface CalculatorFactory {
    fun getCalculator(method: WeldingMethod): ParameterCalculator
}
